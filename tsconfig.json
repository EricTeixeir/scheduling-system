{
  // Covers the root-level config files, scripts/ and tests/; each workspace has its own tsconfig.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": ["*.ts", "*.js", "scripts/**/*.ts", "tests/**/*.ts"]
}
