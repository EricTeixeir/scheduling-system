# Copy to .env and adjust. .env is git-ignored; never commit real credentials.

# PostgreSQL container (docker-compose.yml). The values below are for local development only.
POSTGRES_USER=scheduling
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=scheduling

# Connection string used by Prisma (CLI and API). Must match the values above.
# The host is the compose service name `db`: the database port is not published,
# so it is only reachable from containers on the compose network.
DATABASE_URL=postgresql://scheduling:dev_only_change_me@db:5432/scheduling

# --- API ---------------------------------------------------------------------
# Every variable below is optional except DATABASE_URL (above). Empty means "use the default".

# development | test | production. In production the API refuses to start if
# JWT_SECRET is unset or equals the dev value below, or if DATABASE_URL uses the dev password.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Signs session tokens; at least 32 characters. Dev-only value: generate a real one with
# `node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"`.
JWT_SECRET=dev_only_change_me_jwt_secret_0123456789

# Business rules. The time zone must be an IANA name (e.g. America/Sao_Paulo).
BUSINESS_TIMEZONE=America/Sao_Paulo
MIN_LEAD_MINUTES=60
CANCEL_DEADLINE_MINUTES=30
HORIZON_DAYS=90

# Comma-separated browser origins allowed to call the API with credentials (no wildcard).
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Proxies whose X-Forwarded-For is trusted to find the real client IP (used by rate limiting):
# comma-separated IPs, CIDRs or loopback/linklocal/uniquelocal; "none" trusts no proxy.
TRUST_PROXY=loopback,uniquelocal
# Maximum request body size in bytes.
BODY_LIMIT_BYTES=16384
# Requests per minute per client IP.
RATE_LIMIT_MAX=100

# --- Seed (`npm run db:seed -w @scheduling/api`) ------------------------------
# Demo credentials for local evaluation only; each pair is optional (both or neither).
SEED_ADMIN_EMAIL=euro@admin.com
SEED_ADMIN_PASSWORD=1$3@Euro
SEED_CLIENT_EMAIL=euro@user.com
SEED_CLIENT_PASSWORD=Euro@3$1
