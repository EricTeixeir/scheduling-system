// Constraints Prisma cannot express (exclusion constraint, CHECKs) live in the
// hand-written part ("Part 2") of each migration under migrations/.

generator client {
  provider            = "prisma-client"
  output              = "../src/infra/db/generated"
  moduleFormat        = "esm"
  // Explicit .js specifiers keep the generated code loadable by plain Node ESM after compilation.
  importFileExtension = "js"
}

// The connection URL comes from prisma.config.ts (CLI) and the pg adapter (runtime).
datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  ADMIN
}

// Appointments are confirmed on creation (no approval step). CANCELLED frees the
// slot; COMPLETED and NO_SHOW are historical facts and keep it occupied.
enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model User {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String               @db.VarChar(100)
  // Lowercased by the application and enforced by the users_email_lowercase CHECK,
  // so the unique index is case-insensitive in practice.
  email                String               @unique @db.VarChar(254)
  passwordHash         String               @map("password_hash") @db.Text
  role                 Role                 @default(CLIENT)
  // Consecutive failed logins since the last success; drives the progressive lockout.
  failedLoginCount     Int                  @default(0) @map("failed_login_count")
  lockedUntil          DateTime?            @map("locked_until") @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  appointments         Appointment[]
  refreshTokenFamilies RefreshTokenFamily[]

  @@map("users")
}

model Appointment {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  // Half-open interval [startsAt, endsAt): adjacent slots do not overlap.
  startsAt  DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime          @map("ends_at") @db.Timestamptz(3)
  status    AppointmentStatus @default(CONFIRMED)
  notes     String?           @db.VarChar(500)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, startsAt])
  @@index([status, startsAt])
  @@map("appointments")
}

// One login session. Every rotated refresh token stays in the family it started in, so
// presenting an already-rotated token can revoke the whole session at once. expiresAt is
// absolute: rotation never extends it.
model RefreshTokenFamily {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  expiresAt DateTime       @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime?      @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens    RefreshToken[]

  @@index([userId])
  @@map("refresh_token_families")
}

// Only the SHA-256 of the token is stored. revokedAt is set when the token is rotated or
// its family is revoked: a token with revokedAt is never valid again. rotatedAt is set only by
// rotation, which tells a sibling tab's concurrent refresh apart from a logged-out token.
model RefreshToken {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId  String             @map("family_id") @db.Uuid
  tokenHash String             @unique @map("token_hash") @db.Char(64)
  revokedAt DateTime?          @map("revoked_at") @db.Timestamptz(3)
  rotatedAt DateTime?          @map("rotated_at") @db.Timestamptz(3)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  family    RefreshTokenFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}

// Business hours for one weekday. opensAt/closesAt are LOCAL wall-clock times in
// the business timezone (BUSINESS_TIMEZONE, default America/Sao_Paulo), not UTC.
// A weekday without a row is closed.
model AvailabilityRule {
  // Natural key: one rule per weekday. Never exposed by id to clients, so no UUID.
  // 0 = Sunday ... 6 = Saturday, same numbering as JavaScript Date#getDay.
  weekday     Int      @id @db.SmallInt
  opensAt     DateTime @map("opens_at") @db.Time(0)
  closesAt    DateTime @map("closes_at") @db.Time(0)
  slotMinutes Int      @map("slot_minutes")

  @@map("availability_rules")
}

// A calendar date (in the business timezone) with no availability, e.g. a holiday.
model ClosedDate {
  date   DateTime @id @db.Date
  reason String   @db.VarChar(200)

  @@map("closed_dates")
}
