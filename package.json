{
  "name": "scheduling-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose up --build",
    "down": "docker compose down -v",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:rules",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:coverage": "vitest run --coverage --project=!rules",
    "test:db:up": "docker compose up -d --wait db",
    "test:db:down": "docker compose stop db",
    "test:rules": "docker compose up -d --build --wait && vitest run --project rules",
    "test:rules:conflict": "vitest run --project rules -t conflito",
    "test:rules:past": "vitest run --project rules -t passado",
    "test:rules:persist": "vitest run --project rules -t persist",
    "test:rules:invalid": "vitest run --project rules -t invalid",
    "check:rules": "tsx scripts/check-rules.ts",
    "prepare": "husky",
    "dev:db": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --wait db",
    "dev:api": "npm run db:migrate:deploy -w @scheduling/api && npm run db:seed -w @scheduling/api && npm run dev -w @scheduling/api",
    "dev:web": "npm run dev -w @scheduling/web"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-security": "4.2.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.5"
    }
  }
}
